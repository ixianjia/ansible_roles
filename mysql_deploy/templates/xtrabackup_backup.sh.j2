#!/bin/bash
#
# MySQL XtraBackup 物理备份脚本
# 适用场景: 大规模数据库，支持全量/增量备份
# 用法:
#   ./xtrabackup_backup.sh --full        # 全量备份
#   ./xtrabackup_backup.sh --incremental  # 增量备份
#   ./xtrabackup_backup.sh --dry-run      # 测试运行
#
set -e

# ── 配置 ──────────────────────────────────
MYSQL_BASE="/usr/local/mysql"
BACKUP_DIR="/backup/mysql"
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="backup_user"
MYSQL_PASSWORD="backup_password"
RETENTION_DAYS=7
BACKUP_TYPE="full"
COMPRESS=true
PARALLEL=4
EMAIL="admin@example.com"
LOG_FILE="/var/log/mysql/xtrabackup_backup.log"
INCR_BASE_DIR="$BACKUP_DIR/incremental"

# PATH（cron 环境需要）
export PATH="$MYSQL_BASE/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# ── 参数解析 ──────────────────────────────
DRY_RUN=false
while [[ $# -gt 0 ]]; do
    case $1 in
        --dry-run) DRY_RUN=true; shift ;;
        --full) BACKUP_TYPE="full"; shift ;;
        --incremental) BACKUP_TYPE="incremental"; shift ;;
        --help)
            echo "用法: $0 [选项]"
            echo "选项:"
            echo "  --dry-run       测试运行，不实际执行"
            echo "  --full          全量备份（默认）"
            echo "  --incremental   增量备份"
            echo "  --help          显示帮助"
            exit 0 ;;
        *) echo "未知参数: $1"; exit 1 ;;
    esac
done

# ── 函数 ──────────────────────────────────
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

errorExit() {
    log "错误: $1"
    if [ "$DRY_RUN" = false ]; then
        echo "MySQL XtraBackup 失败 - $1" | mail -s "MySQL XtraBackup Error" "$EMAIL" 2>/dev/null || true
    fi
    exit 1
}

# ── 前置检查 ──────────────────────────────
if [ ! -d "$BACKUP_DIR" ]; then
    errorExit "备份目录 $BACKUP_DIR 不存在"
fi

if ! command -v xtrabackup &>/dev/null; then
    errorExit "xtrabackup 未安装，请先安装 Percona XtraBackup"
fi

# ── 备份参数 ──────────────────────────────
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_PATH="$BACKUP_DIR/xtrabackup_$TIMESTAMP"
mkdir -p "$BACKUP_PATH"

XTRABACKUP_OPTS="--host=$MYSQL_HOST --port=$MYSQL_PORT --user=$MYSQL_USER --password=$MYSQL_PASSWORD"
XTRABACKUP_OPTS="$XTRABACKUP_OPTS --parallel=$PARALLEL --safe-slave-backup --no-lock --slave-info"
if [ "$COMPRESS" = true ]; then
    XTRABACKUP_OPTS="$XTRABACKUP_OPTS --compress --compress-threads=$PARALLEL"
fi

log "开始 MySQL XtraBackup $BACKUP_TYPE 备份"
log "备份路径: $BACKUP_PATH"
log "保留天数: $RETENTION_DAYS 天"

# ── 执行备份 ──────────────────────────────
if [ "$BACKUP_TYPE" = "full" ]; then
    log "执行全量备份..."
    if [ "$DRY_RUN" = true ]; then
        log "[DRY-RUN] xtrabackup $XTRABACKUP_OPTS --backup --target-dir=$BACKUP_PATH"
        exit 0
    fi
    xtrabackup $XTRABACKUP_OPTS --backup --target-dir="$BACKUP_PATH" || errorExit "全量备份失败"

    log "准备备份（apply log）..."
    xtrabackup --prepare --target-dir="$BACKUP_PATH" || errorExit "备份 prepare 失败"

elif [ "$BACKUP_TYPE" = "incremental" ]; then
    log "执行增量备份..."
    LATEST_FULL=$(ls -td "$BACKUP_DIR"/xtrabackup_* 2>/dev/null | head -1 || true)
    if [ -z "$LATEST_FULL" ] || [ ! -d "$LATEST_FULL" ]; then
        errorExit "未找到全量备份，无法执行增量备份。请先执行 --full"
    fi
    mkdir -p "$INCR_BASE_DIR"

    if [ "$DRY_RUN" = true ]; then
        log "[DRY-RUN] xtrabackup --backup --target-dir=$BACKUP_PATH --incremental-basedir=$LATEST_FULL"
        exit 0
    fi

    xtrabackup $XTRABACKUP_OPTS --backup \
      --target-dir="$BACKUP_PATH" \
      --incremental-basedir="$LATEST_FULL" || errorExit "增量备份失败"

    log "合并增量到全量备份..."
    xtrabackup --prepare --apply-log-only \
      --target-dir="$LATEST_FULL" \
      --incremental-dir="$BACKUP_PATH" || errorExit "增量备份 prepare 失败"

    rm -rf "$BACKUP_PATH"
    BACKUP_PATH="$LATEST_FULL"
    log "增量备份已合并到: $BACKUP_PATH"
else
    errorExit "未知的备份类型: $BACKUP_TYPE"
fi

# ── 生成备份信息 ──────────────────────────
if [ "$DRY_RUN" = false ]; then
    {
        echo "MySQL XtraBackup ${BACKUP_TYPE^} Backup"
        echo "备份时间: $(date '+%Y-%m-%d %H:%M:%S')"
        echo "备份节点: $(hostname)"
        echo "备份类型: ${BACKUP_TYPE^}"
        echo "数据大小: $(du -sh "$BACKUP_PATH" | cut -f1)"
        echo "MySQL 版本: $(mysql -V 2>/dev/null || echo 'unknown')"
        echo "XtraBackup 版本: $(xtrabackup --version 2>&1 | head -1)"
    } > "$BACKUP_PATH/backup_info.txt"
fi

# ── 压缩 ──────────────────────────────────
if [ "$COMPRESS" = true ] && [ "$DRY_RUN" = false ]; then
    log "压缩备份..."
    BACKUP_NAME="xtrabackup_${BACKUP_TYPE}_${TIMESTAMP}"
    tar -czf "$BACKUP_DIR/${BACKUP_NAME}.tar.gz" -C "$BACKUP_DIR" "$(basename "$BACKUP_PATH")"
    if [ "$BACKUP_TYPE" = "full" ]; then
        rm -rf "$BACKUP_PATH"
    fi
    log "压缩包: ${BACKUP_NAME}.tar.gz ($(du -sh "$BACKUP_DIR/${BACKUP_NAME}.tar.gz" | cut -f1))"
fi

# ── 清理过期备份 ──────────────────────────
if [ "$DRY_RUN" = false ]; then
    log "清理过期备份..."
    OLD_FULL=$(find "$BACKUP_DIR" -name "xtrabackup_full_*.tar.gz" -mtime +$RETENTION_DAYS | wc -l)
    find "$BACKUP_DIR" -name "xtrabackup_full_*.tar.gz" -mtime +$RETENTION_DAYS -delete

    find "$BACKUP_DIR" -name "xtrabackup_incremental_*" -mtime +$RETENTION_DAYS -type d -exec rm -rf {} + 2>/dev/null || true
    find "$BACKUP_DIR" -type d -empty -delete 2>/dev/null || true

    log "清理过期备份: $OLD_FULL 个全量包"
fi

# ── 完成 ──────────────────────────────────
DISK_USAGE=$(du -sh "$BACKUP_DIR" | cut -f1)
log "备份目录总用量: $DISK_USAGE"

if [ "$DRY_RUN" = false ]; then
    log "MySQL XtraBackup ${BACKUP_TYPE^} 备份完成"
    echo "MySQL XtraBackup ${BACKUP_TYPE^} 备份完成 - $(date '+%Y-%m-%d %H:%M:%S')" \
      | mail -s "MySQL XtraBackup Success" "$EMAIL" 2>/dev/null || true
fi

exit 0

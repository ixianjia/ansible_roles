#!/bin/bash
#
# MySQL mysqldump 逻辑备份脚本
# 适用场景: 中小规模数据库，单库粒度备份
# 备份方式: --single-transaction 无锁备份
#
set -e

# ── 配置 ──────────────────────────────────
MYSQL_BASE="/usr/local/mysql"
BACKUP_DIR="/backup/mysql"
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="backup_user"
MYSQL_PASSWORD="backup_password"
RETENTION_DAYS=7
COMPRESS=true
EMAIL="admin@example.com"
LOG_FILE="/var/log/mysql/mysqldump_backup.log"

# 备份排除的数据库
EXCLUDE_DB="information_schema|performance_schema|mysql|sys"

# PATH（cron 环境需要）
export PATH="$MYSQL_BASE/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# ── 函数 ──────────────────────────────────
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

errorExit() {
    log "错误: $1"
    echo "MySQL 备份失败 - $1" | mail -s "MySQL Backup Error" "$EMAIL" 2>/dev/null || true
    exit 1
}

# ── 前置检查 ──────────────────────────────
if [ ! -d "$BACKUP_DIR" ]; then
    errorExit "备份目录 $BACKUP_DIR 不存在"
fi

if ! command -v mysql &>/dev/null; then
    errorExit "mysql 客户端未找到，请检查 PATH"
fi

# ── 开始备份 ──────────────────────────────
log "开始 MySQL mysqldump 备份"
log "备份目录: $BACKUP_DIR"
log "保留天数: $RETENTION_DAYS 天"

# 获取数据库列表（排除系统库）
DATABASES=$(mysql -h "$MYSQL_HOST" -P "$MYSQL_PORT" \
  -u "$MYSQL_USER" -p"$MYSQL_PASSWORD" \
  -e "SHOW DATABASES;" 2>/dev/null \
  | grep -vE "^(Database|$EXCLUDE_DB)$" || true)

if [ -z "$DATABASES" ]; then
    log "警告: 没有找到需要备份的数据库"
    exit 0
fi

TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_PATH="$BACKUP_DIR/mysqldump_$TIMESTAMP"
mkdir -p "$BACKUP_PATH"
log "创建备份目录: $BACKUP_PATH"

# 逐库备份
for DB in $DATABASES; do
    log "备份数据库: $DB"
    if [ "$COMPRESS" = true ]; then
        mysqldump -h "$MYSQL_HOST" -P "$MYSQL_PORT" \
          -u "$MYSQL_USER" -p"$MYSQL_PASSWORD" \
          --single-transaction --routines --triggers --events \
          --hex-blob --opt --set-gtid-purged=OFF \
          --max-allowed-packet=256M "$DB" \
          | gzip > "$BACKUP_PATH/${DB}_${TIMESTAMP}.sql.gz"
    else
        mysqldump -h "$MYSQL_HOST" -P "$MYSQL_PORT" \
          -u "$MYSQL_USER" -p"$MYSQL_PASSWORD" \
          --single-transaction --routines --triggers --events \
          --hex-blob --opt --set-gtid-purged=OFF \
          --max-allowed-packet=256M "$DB" \
          > "$BACKUP_PATH/${DB}_${TIMESTAMP}.sql"
    fi

    # 校验文件完整性
    if [ -f "$BACKUP_PATH/${DB}_${TIMESTAMP}.sql.gz" ] || [ -f "$BACKUP_PATH/${DB}_${TIMESTAMP}.sql" ]; then
        log "完成: $DB"
    else
        errorExit "备份 $DB 失败 - 输出文件不存在"
    fi
done

# 生成备份清单
{
    echo "MySQL mysqldump 备份 - $(date '+%Y-%m-%d %H:%M:%S')"
    echo "备份节点: $(hostname)"
    echo "MySQL 版本: $(mysql -V 2>/dev/null || echo 'unknown')"
    echo "备份包含数据库:"
    for DB in $DATABASES; do
        FILE_SIZE=$(ls -lh "$BACKUP_PATH/${DB}_${TIMESTAMP}.sql"* 2>/dev/null | awk '{print $5}')
        echo "  - $DB (${FILE_SIZE:-unknown})"
    done
} > "$BACKUP_PATH/manifest.txt"

# 打包压缩
cd "$BACKUP_DIR"
tar -czf "mysqldump_full_${TIMESTAMP}.tar.gz" "mysqldump_$TIMESTAMP"
rm -rf "mysqldump_$TIMESTAMP"

log "完整备份包: mysqldump_full_${TIMESTAMP}.tar.gz"
log "备份大小: $(du -sh "mysqldump_full_${TIMESTAMP}.tar.gz" | cut -f1)"

# 清理过期备份
OLD_COUNT=$(find "$BACKUP_DIR" -name "mysqldump_full_*.tar.gz" -mtime +$RETENTION_DAYS | wc -l)
find "$BACKUP_DIR" -name "mysqldump_full_*.tar.gz" -mtime +$RETENTION_DAYS -delete
log "清理过期备份: $OLD_COUNT 个"

DISK_USAGE=$(du -sh "$BACKUP_DIR" | cut -f1)
log "备份目录总用量: $DISK_USAGE"

# 完成通知
log "MySQL mysqldump 备份完成"
echo "MySQL 备份成功完成 - $(date '+%Y-%m-%d %H:%M:%S')" \
  | mail -s "MySQL Backup Success" "$EMAIL" 2>/dev/null || true

exit 0
